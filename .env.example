# OSSPilot environment variables
# Copy to .env (never commit) or set in your shell profile.

# GitHub token (preferred over gh-cli bootstrap)
OSSPILOT_GITHUB_TOKEN=

# BharatCode API key (from https://bharatcode.ai/account)
OSSPILOT_BHARATCODE_API_KEY=

# Optional overrides
# OSSPILOT_HOME=/custom/path
# OSSPILOT_LOG_LEVEL=info
# OSSPILOT_LOG_FORMAT=json
# OSSPILOT_LOG_SINK=file
